{
  "info": {
    "name": "Nexora notification-service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "All implemented routes through Kong. See postman/README.md for prerequisites, cookie authentication and native WebSocket testing."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "ws_base_url",
      "value": "ws://localhost:8000"
    },
    {
      "key": "origin",
      "value": "http://localhost:3000"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "new_password",
      "value": ""
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "csrf_token",
      "value": ""
    },
    {
      "key": "admin_access_token",
      "value": ""
    },
    {
      "key": "user_id",
      "value": ""
    },
    {
      "key": "target_user_id",
      "value": ""
    },
    {
      "key": "role_id",
      "value": ""
    },
    {
      "key": "session_id",
      "value": ""
    },
    {
      "key": "post_id",
      "value": ""
    },
    {
      "key": "participant_id",
      "value": ""
    },
    {
      "key": "conversation_id",
      "value": ""
    },
    {
      "key": "message_id",
      "value": ""
    },
    {
      "key": "notification_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "List notifications",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "url": "{{base_url}}/api/v1/notifications?page=1&limit=30"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { const data = pm.response.json(); pm.test(\"Paginated items\", () => pm.expect(data.items).to.be.an(\"array\")); if (data.items.length) pm.collectionVariables.set(\"notification_id\", data.items[0].id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Unread count",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "url": "{{base_url}}/api/v1/notifications/unread-count"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Mark notification read",
      "request": {
        "method": "PATCH",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "url": "{{base_url}}/api/v1/notifications/{{notification_id}}/read"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Mark all read",
      "request": {
        "method": "PATCH",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "url": "{{base_url}}/api/v1/notifications/read-all"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete notification",
      "request": {
        "method": "DELETE",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "url": "{{base_url}}/api/v1/notifications/{{notification_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "WebSocket connection \u2014 handshake reference",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Connection",
            "value": "Upgrade"
          },
          {
            "key": "Upgrade",
            "value": "websocket"
          },
          {
            "key": "Sec-WebSocket-Version",
            "value": "13"
          },
          {
            "key": "Sec-WebSocket-Key",
            "value": "dGhlIHNhbXBsZSBub25jZQ=="
          },
          {
            "key": "Sec-WebSocket-Protocol",
            "value": "notifications.v1"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "url": "{{base_url}}/api/v1/notifications/ws",
        "description": "Use a NEW WebSocket request in Postman at {{ws_base_url}}/api/v1/notifications/ws with Authorization: Bearer {{access_token}}. This HTTP entry documents the handshake; Collection Runner cannot exercise realtime frames. Do not pass userId or JWT in the URL. See docs/NOTIFICATION_SERVICE.md."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(101));"
            ]
          }
        }
      ]
    },
    {
      "name": "notifications health",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/notifications/health",
        "header": [],
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "notifications readiness",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/notifications/ready",
        "header": [],
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ]
}
