    {
      "name": "06 - Session mutations (run individually)",
      "item": [
        {
          "name": "Revoke selected session",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/v1/auth/sessions/{{session_id}}",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected status\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Change password (invalidates sessions)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/auth/change-password",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{{password_body}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected status\", () => pm.response.to.have.status(204));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set(\"password_body\", JSON.stringify({current_password: pm.variables.get(\"password\"), new_password: pm.variables.get(\"new_password\")}));"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout all sessions",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/auth/logout-all",
            "header": [],
