    {
      "name": "08 - WebSocket references (use native client)",
      "item": [
        {
          "name": "Chat WebSocket handshake reference",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Connection",
                "value": "Upgrade"
              },
              {
                "key": "Upgrade",
                "value": "websocket"
              },
              {
                "key": "Sec-WebSocket-Version",
                "value": "13"
              },
              {
                "key": "Sec-WebSocket-Key",
                "value": "dGhlIHNhbXBsZSBub25jZQ=="
              },
              {
                "key": "Sec-WebSocket-Protocol",
                "value": "chat.v1"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{base_url}}/api/v1/chats/ws",
            "description": "Create a native Postman WebSocket request at {{ws_base_url}}/api/v1/chats/ws with Authorization: Bearer {{access_token}} and Sec-WebSocket-Protocol: chat.v1. HTTP Collection Runner cannot verify frames. See docs/CHAT_SERVICE.md."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected status\", () => pm.response.to.have.status(101));"
                ]
              }
            }
          ]
        },
        {
          "name": "WebSocket connection \u2014 handshake reference",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Connection",
                "value": "Upgrade"
              },
              {
                "key": "Upgrade",
                "value": "websocket"
              },
              {
                "key": "Sec-WebSocket-Version",
                "value": "13"
              },
              {
                "key": "Sec-WebSocket-Key",
                "value": "dGhlIHNhbXBsZSBub25jZQ=="
              },
              {
                "key": "Sec-WebSocket-Protocol",
                "value": "notifications.v1"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{base_url}}/api/v1/notifications/ws",
            "description": "Use a NEW WebSocket request in Postman at {{ws_base_url}}/api/v1/notifications/ws with Authorization: Bearer {{access_token}}. This HTTP entry documents the handshake; Collection Runner cannot exercise realtime frames. Do not pass userId or JWT in the URL. See docs/NOTIFICATION_SERVICE.md."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected status\", () => pm.response.to.have.status(101));"
                ]
              }
            }
          ]
        }
