{
  "info": {
    "name": "Nexora auth-service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "All implemented routes through Kong. See postman/README.md for prerequisites, cookie authentication and native WebSocket testing."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "ws_base_url",
      "value": "ws://localhost:8000"
    },
    {
      "key": "origin",
      "value": "http://localhost:3000"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "new_password",
      "value": ""
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "csrf_token",
      "value": ""
    },
    {
      "key": "admin_access_token",
      "value": ""
    },
    {
      "key": "user_id",
      "value": ""
    },
    {
      "key": "target_user_id",
      "value": ""
    },
    {
      "key": "role_id",
      "value": ""
    },
    {
      "key": "session_id",
      "value": ""
    },
    {
      "key": "post_id",
      "value": ""
    },
    {
      "key": "participant_id",
      "value": ""
    },
    {
      "key": "conversation_id",
      "value": ""
    },
    {
      "key": "message_id",
      "value": ""
    },
    {
      "key": "notification_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/v1/auth/register",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{origin}}"
          },
          {
            "key": "X-CSRF-Protection",
            "value": "1"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{{credentials_body}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(201));"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set(\"credentials_body\", JSON.stringify({email: pm.variables.get(\"email\"), password: pm.variables.get(\"password\")}));"
            ]
          }
        }
      ]
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/v1/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{origin}}"
          },
          {
            "key": "X-CSRF-Protection",
            "value": "1"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{{credentials_body}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json().data;",
              "  pm.collectionVariables.set(\"access_token\", data.access_token);",
              "  pm.collectionVariables.set(\"csrf_token\", data.csrf_token);",
              "}"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set(\"credentials_body\", JSON.stringify({email: pm.variables.get(\"email\"), password: pm.variables.get(\"password\")}));"
            ]
          }
        }
      ]
    },
    {
      "name": "Authenticated user",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/auth/me",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const value = pm.response.json().data.id;",
              "  if (value) pm.collectionVariables.set(\"user_id\", value);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Restore CSRF token",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/v1/auth/csrf",
        "header": [
          {
            "key": "Origin",
            "value": "{{origin}}"
          },
          {
            "key": "X-CSRF-Protection",
            "value": "1"
          }
        ],
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const value = pm.response.json().data.csrf_token;",
              "  if (value) pm.collectionVariables.set(\"csrf_token\", value);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Refresh session",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/v1/auth/refresh",
        "header": [
          {
            "key": "Origin",
            "value": "{{origin}}"
          },
          {
            "key": "X-CSRF-Protection",
            "value": "1"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf_token}}"
          }
        ],
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json().data;",
              "  pm.collectionVariables.set(\"access_token\", data.access_token);",
              "  pm.collectionVariables.set(\"csrf_token\", data.csrf_token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "List sessions",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/auth/sessions",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Revoke selected session",
      "request": {
        "method": "DELETE",
        "url": "{{base_url}}/api/v1/auth/sessions/{{session_id}}",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Change password (invalidates sessions)",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/v1/auth/change-password",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{{password_body}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(204));"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set(\"password_body\", JSON.stringify({current_password: pm.variables.get(\"password\"), new_password: pm.variables.get(\"new_password\")}));"
            ]
          }
        }
      ]
    },
    {
      "name": "Logout all sessions",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/v1/auth/logout-all",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Logout current cookie session",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/v1/auth/logout",
        "header": [
          {
            "key": "Origin",
            "value": "{{origin}}"
          },
          {
            "key": "X-CSRF-Protection",
            "value": "1"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf_token}}"
          }
        ],
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Assign role",
      "request": {
        "method": "PUT",
        "url": "{{base_url}}/api/v1/auth/admin/users/{{target_user_id}}/roles/{{role_id}}",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{admin_access_token}}",
              "type": "string"
            }
          ]
        },
        "description": "Requires admin role, admin.users.manage permission and authentication within five minutes. Supply existing target user and role UUIDs."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Remove role",
      "request": {
        "method": "DELETE",
        "url": "{{base_url}}/api/v1/auth/admin/users/{{target_user_id}}/roles/{{role_id}}",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{admin_access_token}}",
              "type": "string"
            }
          ]
        },
        "description": "Requires admin role, admin.users.manage permission and authentication within five minutes. Supply existing target user and role UUIDs."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "auth health",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/auth/health",
        "header": [],
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ]
}
