# Run python scripts/setup-security-dev.py to generate a local .env and RSA keys.
APP_ENV=development
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_USER=app_auth
POSTGRES_PASSWORD=REPLACE_AUTH_DATABASE_PASSWORD
POSTGRES_ADMIN_PASSWORD=REPLACE_MIGRATION_DATABASE_PASSWORD
POST_DATABASE_PASSWORD=REPLACE_POST_DATABASE_PASSWORD
CHAT_DATABASE_PASSWORD=REPLACE_CHAT_DATABASE_PASSWORD
NOTIFICATION_DATABASE_PASSWORD=REPLACE_NOTIFICATION_DATABASE_PASSWORD
POSTGRES_DB=social_media
POSTGRES_SSLMODE=disable
REDIS_PASSWORD=REPLACE_REDIS_PASSWORD
REDIS_ADDR=redis://:REPLACE_REDIS_PASSWORD@localhost:6379/0
JWT_PRIVATE_KEY_FILE=.secrets/private.pem
JWT_PUBLIC_KEYS_FILE=.secrets/public-keys.json
JWT_KEY_ID=development-1
JWT_ISSUER=social-media-auth
REFRESH_TOKEN_TTL=168h
ALLOWED_ORIGINS=http://localhost:3000
# Only loopback development may use insecure cookies. Production requires HTTPS.
AUTH_COOKIE_INSECURE=true
TLS_TERMINATED=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_REQUESTS=10
RATE_LIMIT_LOGIN_WINDOW=1m
RATE_LIMIT_LOGIN_ACCOUNT_REQUESTS=20
RATE_LIMIT_LOGIN_ACCOUNT_WINDOW=10m
RATE_LIMIT_REFRESH_REQUESTS=30
RATE_LIMIT_REFRESH_WINDOW=1m
RATE_LIMIT_REFRESH_ACCOUNT_REQUESTS=5
RATE_LIMIT_REFRESH_ACCOUNT_WINDOW=1m
TRUSTED_PROXIES=
LOCAL_UID=1000
LOCAL_GID=1000

# Chat limits (bytes, durations, and per-user events/minute).
WS_MAX_MESSAGE_SIZE=16384
CHAT_MESSAGE_MAX_LENGTH=4096
WS_SEND_QUEUE=64
WS_MAX_CONNECTIONS_PER_USER=8
WS_WRITE_TIMEOUT=10s
WS_READ_TIMEOUT=60s
WS_PING_INTERVAL=25s
CHAT_RATE_LIMIT=120

# Notification stream is shared by post/chat producers and notification consumers.
NOTIFICATION_STREAM=events:notifications
NOTIFICATION_CONSUMER_GROUP=notification-service
NOTIFICATION_RETRY_IDLE=30s
NOTIFICATION_MAX_ATTEMPTS=10
NOTIFICATION_PAGE_SIZE=30
WS_PONG_TIMEOUT=60s
