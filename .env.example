APP_ENV=development

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=social_media
POSTGRES_SSLMODE=disable

REDIS_ADDR=redis:6379

JWT_SECRET=change-me

AUTH_SERVICE_PORT=8001
USER_SERVICE_PORT=8002
POST_SERVICE_PORT=8003
CHAT_SERVICE_PORT=8004
NOTIFICATION_SERVICE_PORT=8005

AUTH_SERVICE_URL=http://auth-service:8001
USER_SERVICE_URL=http://user-service:8002
POST_SERVICE_URL=http://post-service:8003
CHAT_SERVICE_URL=http://chat-service:8004
NOTIFICATION_SERVICE_URL=http://notification-service:8005

# Distributed limiter (all replicas must use identical settings and Redis DB).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_REQUESTS=100
RATE_LIMIT_GLOBAL_WINDOW=1m
RATE_LIMIT_REGISTER_REQUESTS=3
RATE_LIMIT_REGISTER_WINDOW=10m
# Available for explicit attachment when WebSocket routes are implemented.
RATE_LIMIT_WEBSOCKET_REQUESTS=10
RATE_LIMIT_WEBSOCKET_WINDOW=1m
RATE_LIMIT_REDIS_TIMEOUT=200ms
# Comma-separated ingress proxy IPs/CIDRs; empty trusts no forwarded headers.
TRUSTED_PROXIES=
