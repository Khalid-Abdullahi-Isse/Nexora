{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "deploymentMode": {
      "enum": [
        "helm",
        "argocd"
      ]
    },
    "global": {
      "type": "object",
      "properties": {
        "environment": {
          "enum": [
            "development",
            "test",
            "production"
          ]
        },
        "imagePullPolicy": {
          "enum": [
            "Never",
            "IfNotPresent",
            "Always"
          ]
        }
      }
    },
    "postgres": {
      "type": "object",
      "properties": {
        "database": {
          "const": "social_media"
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "repository",
          "tag"
        ],
        "properties": {
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "tag": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "kong": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxBodyKilobytes": {
          "type": "integer",
          "minimum": 1
        },
        "rateLimit": {
          "type": "object",
          "properties": {
            "minute": {
              "type": "integer",
              "minimum": 1
            },
            "authMinute": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "proxy": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "httpPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "httpsPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        }
      }
    }
  }
}
